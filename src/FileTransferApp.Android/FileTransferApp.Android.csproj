<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- minSdk=23 对应 SupportedOSPlatformVersion -->
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <!-- 目标 SDK: 与 net10.0-android 默认一致（API 36），无需额外声明 -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.CompanyName.FileTransferApp</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>

    <!-- ====== 修复「解析包时出现问题」的 3 项关键配置 ====== -->
    <!-- (1) ABI：同时输出 arm64-v8a (64位主流) + armeabi-v7a (32位兼容中低端/旧机)。
             仅 64 位会在 32 位设备上报 INSTALL_FAILED_NO_MATCHING_ABIS，表现为"解析包错误"。
             .NET for Android 标准属性名是 AndroidSupportedAbis（分号分隔，大小写敏感），
             在 Build+Publish 全流程中生效，移除 x86_64 进一步减包体（真机极少见 x86_64）。 -->
    <AndroidSupportedAbis>arm64-v8a;armeabi-v7a</AndroidSupportedAbis>

    <!-- (2) 签名方案：V1 (JAR签名，Android 7- 必需) + V2 (整包签名，Android 7+ 必需)
             仅 V2 无 V1 会在 Android 6 及以下出现解析失败 -->
    <AndroidSigningPackageFormat>apk</AndroidSigningPackageFormat>
    <AndroidUseApkSigner>true</AndroidUseApkSigner>
    <AndroidApkSignerAdditionalArguments>--v1-signing-enabled true --v2-signing-enabled true</AndroidApkSignerAdditionalArguments>

    <!-- (3) Zipalign：启用 ZIP 对齐，提升加载性能并满足部分 ROM 的严格校验 -->
    <AndroidEnableZipAlign>true</AndroidEnableZipAlign>
  </PropertyGroup>

  <ItemGroup>
    <!-- 分密度 mipmap 启动图标（mdpi~xxxhdpi），桌面与启动器自动按 DPI 取 -->
    <AndroidResource Include="Resources\mipmap-mdpi\Icon.png" />
    <AndroidResource Include="Resources\mipmap-hdpi\Icon.png" />
    <AndroidResource Include="Resources\mipmap-xhdpi\Icon.png" />
    <AndroidResource Include="Resources\mipmap-xxhdpi\Icon.png" />
    <AndroidResource Include="Resources\mipmap-xxxhdpi\Icon.png" />

    <!-- drawable/Icon.png：AndroidManifest @drawable/icon + 通知栏小图标 + splash 品牌图 (288x288) -->
    <AndroidResource Include="Resources\drawable\Icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileTransferApp\FileTransferApp.csproj" />
  </ItemGroup>
</Project>
