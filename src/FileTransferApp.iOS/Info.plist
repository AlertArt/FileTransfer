<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>FileTransferApp</string>
	<key>CFBundleIdentifier</key>
	<string>companyName.FileTransferApp</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1.0</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>13.0</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<!-- 后台短暂执行：申请 BeginBackgroundTask 时间窗，支持熄屏后完成当前切片 -->
		<string>fetch</string>
		<!-- 后台网络：HTTP 传输在切后台时继续完成进行中的请求 -->
		<string>remote-notification</string>
	</array>
	<key>UIRequiresPersistentWiFi</key>
	<true/>
	<!-- iOS 14+ 局域网访问声明：未配置时 UDP 多播与本地 HTTP 请求会被系统静默阻断 -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>需要访问局域网以发现附近设备并传输文件</string>
	<!-- iOS 14+ 本地网络触发：用于 UDP 多播设备发现 -->
	<key>NSBonjourServices</key>
	<array>
		<string>_filetransfer._udp</string>
		<string>_filetransfer._tcp</string>
	</array>
</dict>
</plist>
