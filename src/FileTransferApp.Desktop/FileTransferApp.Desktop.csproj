<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 多目标：
         - net10.0                          → 跨平台桌面（Windows / macOS / Linux）
         - net10.0-windows10.0.19041.0      → 启用 Windows SDK 投影（Windows.UI.Notifications）以支持系统 Toast
         Windows 专属能力（Toast / 防火墙 / 清单 / 图标）仅在 windows 目标编译。 -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>快传 · Nearby Transfer</AssemblyTitle>
    <Product>快传 · Nearby Transfer</Product>
    <Description>跨平台（Windows/Android）局域网快传工具</Description>
    <Version>1.1.8</Version>
  </PropertyGroup>

  <!-- Windows 专属构建属性 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- 将图标复制到发布目录，方便用户直接取 PNG/ICO。 -->
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <!-- Windows Toast 依赖仅在 windows 目标引入；WindowsNotificationService 亦只在 windows 目标编译 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" />
    <!-- 显式引用以覆盖 Toast 工具包的传递依赖 4.7.0（安全更新） -->
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows10.0.19041.0'">
    <Compile Remove="Services\WindowsNotificationService.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileTransferApp\FileTransferApp.csproj" />
  </ItemGroup>
</Project>
