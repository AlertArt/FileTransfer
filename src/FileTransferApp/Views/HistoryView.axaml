<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FileTransferApp.ViewModels"
             xmlns:svc="using:FileTransferApp.Services"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
             x:Class="FileTransferApp.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

    <DockPanel>

        <!-- 头：标题 + 清空 -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Text="{svc:Localize Key=HistoryTitle}"
                       Classes="Title"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="{svc:Localize Key=HistoryClear}"
                    Command="{Binding ClearCommand}"
                    IsEnabled="{Binding HasEntries}" />
        </Grid>

        <Border Background="{DynamicResource Brush.SurfaceAlt}"
                CornerRadius="{DynamicResource Radius.Md}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                Padding="8">
            <Grid>
                <TextBlock Text="{svc:Localize Key=HistoryEmpty}"
                           Classes="Muted"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="{Binding !HasEntries}" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:HistoryItemViewModel">
                                <Border Classes="TransferCard"
                                        Background="{DynamicResource Brush.Surface}"
                                        CornerRadius="{DynamicResource Radius.Lg}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1"
                                        BoxShadow="{DynamicResource Shadow.Sm}"
                                        Margin="0,0,0,6">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding FileName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Meta}" Classes="Muted" />
                                        <Border Background="{DynamicResource Brush.ErrorBg}"
                                                BorderBrush="{DynamicResource Brush.ErrorBorder}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource Radius.Sm}"
                                                Padding="6,4"
                                                IsVisible="{Binding HasError}">
                                            <TextBlock Text="{Binding Error}"
                                                       Foreground="{DynamicResource Brush.ErrorText}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
