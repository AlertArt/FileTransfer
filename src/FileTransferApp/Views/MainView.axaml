<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FileTransferApp.ViewModels"
             xmlns:models="using:FileTransferApp.Core.Models"
             xmlns:conv="using:FileTransferApp.Converters"
             xmlns:svc="using:FileTransferApp.Services"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="760"
             x:Class="FileTransferApp.Views.MainView"
             x:DataType="vm:MainViewModel"
             DragDrop.AllowDrop="True">

    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor" />
    </UserControl.Resources>

    <!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++
         响应式样式：基于 RootGrid 上的 Classes.compact / Classes.short 级联
         - compact (竖屏手机, 宽<600)：单列布局，压缩 padding、缩小缩略图、隐藏次要文案
         - short   (横屏手机, 宽≥600 但高<500)：两栏布局，压缩顶栏/底栏纵向 padding
         两者互斥(IsCompact 优先)，通过 Grid.compact > / Grid.short > 直接子选择器命中
         +++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <UserControl.Styles>
        <!-- 基础样式(标准模式=桌面/平板)：把要响应式覆盖的 inline 值提到 Style，
             否则 Avalonia 中 inline 值优先级高于 Style setter，覆盖不生效 -->
        <Style Selector="Border.TopBar">
            <Setter Property="Padding" Value="16,14,16,18" />
        </Style>
        <Style Selector="Border.BottomBar">
            <Setter Property="Padding" Value="16,10" />
        </Style>
        <Style Selector="Border.TransferCard">
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style Selector="Border.ThumbArea">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
        </Style>

        <!-- 竖屏手机(compact, 宽<600)：单列布局，压缩 padding、缩小缩略图 -->
        <Style Selector="Grid.compact > Border.TopBar">
            <Setter Property="Padding" Value="12,10,12,12" />
        </Style>
        <Style Selector="Grid.compact > Border.BottomBar">
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="Grid.compact Border.TransferCard">
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="Grid.compact Border.ThumbArea">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
        </Style>

        <!-- 横屏手机(short, 宽≥600 但高<500)：两栏布局，压缩顶栏/底栏纵向 padding -->
        <Style Selector="Grid.short > Border.TopBar">
            <Setter Property="Padding" Value="12,6,12,8" />
            <Setter Property="CornerRadius" Value="0,0,16,16" />
            <Setter Property="BoxShadow" Value="0 4 12 0 rgba(99,102,241,0.18)" />
        </Style>
        <Style Selector="Grid.short > Border.BottomBar">
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style Selector="Grid.short Border.TransferCard">
            <Setter Property="Padding" Value="14,8" />
        </Style>
    </UserControl.Styles>


    <!-- 根背景：现代 App 惯用的「浅灰底」，承载白色卡片形成层次感 -->
    <!-- AutoSafeAreaPadding：Android/iOS 沉浸式状态栏下，自动为根布局补安全区内边距，
         避免顶/底部控件与系统状态栏/手势条重叠（桌面窗口无 insets，不受影响） -->
    <Grid RowDefinitions="Auto,*,Auto"
          x:Name="RootGrid"
          Background="{DynamicResource Brush.SurfaceAlt}"
          TopLevel.AutoSafeAreaPadding="True"
          Classes.compact="{Binding IsCompact}"
          Classes.short="{Binding IsShort}">

        <!-- +++++ 顶栏：品牌感 + 主操作 +++++ -->
        <Border Classes="TopBar"
                Background="{DynamicResource Brush.BrandGradient}"
                CornerRadius="0,0,16,16"
                BoxShadow="0 8 24 0 rgba(99,102,241,0.25)">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="4">
                <!-- 品牌 Logo + 标题 -->
                <Border Grid.RowSpan="2"
                        Background="#FFFFFF33"
                        CornerRadius="12"
                        Padding="10,8"
                        Width="44" Height="44"
                        VerticalAlignment="Center">
                    <TextBlock Text="🚀"
                               FontSize="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="2">
                    <TextBlock Text="{svc:Localize Key=AppTitle}"
                               Classes="Title"
                               FontSize="16"
                               Foreground="{DynamicResource Brush.TextOnBrand}" />
                </StackPanel>
                <!-- 主操作：选择文件（标准模式：完整文字按钮） -->
                <Button Grid.Column="2" Grid.RowSpan="2"
                        Classes="Primary"
                        Content="{svc:Localize Key=SelectFileSend}"
                        Command="{Binding SendFileCommand}"
                        IsEnabled="{Binding Devices.SelectedDevice, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Padding="20,10"
                        IsVisible="{Binding !IsCompact}" />
                <!-- 主操作：选择文件（竖屏紧凑模式：图标按钮省横向空间） -->
                <Button Grid.Column="2" Grid.RowSpan="2"
                        Classes="Primary"
                        Content="📁"
                        FontSize="18"
                        Command="{Binding SendFileCommand}"
                        IsEnabled="{Binding Devices.SelectedDevice, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Padding="0"
                        Width="44" Height="44"
                        IsVisible="{Binding IsCompact}" />
            </Grid>
        </Border>

        <!-- +++++ 主体：设备发现 + 传输任务（卡片式） +++++ -->
        <!-- LayoutRoot 的列/行定义 + DevicesPanel/TransfersPanel 的 Grid.Row/Grid.Column，
             由 MainView.axaml.cs 中 UpdateLayoutForCompact() 按 IsCompact 动态设置：
             - 宽屏：设备=左(320) / 传输=右(*)
             - 窄屏：设备=上(Auto, 限高260) / 传输=下(*) -->
        <Grid Grid.Row="1" Margin="12,12,12,8">
            <Grid x:Name="LayoutRoot">

                <!-- [左上] 附近设备卡片 -->
                <Border x:Name="DevicesPanel"
                        Classes="DevicesPanel Card"
                        Grid.Row="0" Grid.Column="0"
                        Margin="0,0,12,0">
                    <DockPanel LastChildFill="True">
                        <!-- 卡片标题 + 在线数徽标 -->
                        <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{svc:Localize Key=NearbyDevices}"
                                       Classes="Title"
                                       FontSize="16" />
                            <Border DockPanel.Dock="Right"
                                    Background="{DynamicResource Brush.Brand}"
                                    CornerRadius="{DynamicResource Radius.Pill}"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{svc:Localize Key=OnlineCount, Args={Binding Devices.Devices.Count}}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextOnBrand}" />
                            </Border>
                        </DockPanel>

                        <!-- 主操作按钮（紧凑模式也能用） -->
                        <Button DockPanel.Dock="Bottom"
                                Classes="Primary"
                                Content="{svc:Localize Key=SelectFileAndSend}"
                                Command="{Binding SendFileCommand}"
                                IsEnabled="{Binding Devices.SelectedDevice, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Margin="0,10,0,0" />

                        <!-- 直连输入区 -->
                        <Border DockPanel.Dock="Bottom"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                CornerRadius="{DynamicResource Radius.Md}"
                                Padding="10,8"
                                Margin="0,10,0,0">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                                  ColumnSpacing="8" RowSpacing="6">
                                <TextBox Grid.Column="0"
                                         Text="{Binding Devices.ManualIp}"
                                         PlaceholderText="{svc:Localize Key=ManualIpPlaceholder}" />
                                <Button Grid.Column="1"
                                        Content="{svc:Localize Key=Connect}"
                                        Command="{Binding ManualConnectCommand}" />
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                           Classes="Muted"
                                           Text="{svc:Localize Key=PortHint, Args={Binding Devices.ManualPort}}"
                                           IsVisible="{Binding !IsCompact}" />
                            </Grid>
                        </Border>

                        <!-- 设备列表 -->
                        <Border CornerRadius="{DynamicResource Radius.Lg}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                Margin="0,10,0,0">
                            <Grid>
                                <!-- 空态：简洁提示（微信风格，本机信息移至"关于"页） -->
                                <StackPanel IsVisible="{Binding Devices.IsEmpty}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="10"
                                            Margin="12,16">
                                    <TextBlock Text="🔍"
                                               FontSize="28"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{svc:Localize Key=DeviceEmptyWaiting}"
                                               Classes="Muted"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center" />
                                </StackPanel>
                                <ListBox ItemsSource="{Binding Devices.Devices}"
                                         SelectedItem="{Binding Devices.SelectedDevice}"
                                         Background="#00000000"
                                         Padding="4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="models:DeviceNode">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="2" VerticalAlignment="Center">
                                            <!-- 设备头像（Windows/Android 标识色） -->
                                            <Border Width="40" Height="40" CornerRadius="{DynamicResource Radius.Md}"
                                                    Background="{Binding DeviceType,
                                                        Converter={x:Static conv:DeviceTypeToBrushConverter.Instance}}"
                                                    Margin="0,0,10,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontSize="18"
                                                           Text="{Binding DeviceType,
                                                               Converter={x:Static conv:DeviceTypeToGlyphConverter.Instance}}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" FontSize="14"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding EndPoint}" Classes="Muted" />
                                            </StackPanel>
                                            <!-- 选中指示：箭头 -->
                                            <TextBlock Grid.Column="2" Text="›" FontSize="22"
                                                       Foreground="{DynamicResource Brush.TextMuted}"
                                                       VerticalAlignment="Center" Margin="4,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </Grid>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- [右下] 传输任务列表卡片 -->
                <Border x:Name="TransfersPanel"
                        Grid.Row="1" Grid.Column="1"
                        Classes="Card">
                    <DockPanel LastChildFill="True">
                        <!-- 标题 + 提示 -->
                        <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{svc:Localize Key=TransferTasks}"
                                       Classes="Title"
                                       FontSize="16" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{svc:Localize Key=DragDropHint}"
                                       Classes="Muted"
                                       IsVisible="{Binding !IsCompact}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- +++++ 传输列表内容区：空态提示 + 列表 +++++ -->
                        <Grid>
                            <StackPanel IsVisible="{Binding !HasTransfers}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="6"
                                        Margin="12,20">
                                <TextBlock Text="📄"
                                           FontSize="28"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{svc:Localize Key=TransferEmptyHint}"
                                           Classes="Body"
                                           TextAlignment="Center" />
                            </StackPanel>
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Transfers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:TransferItemViewModel">
                                        <!-- 现代任务卡片：白底 + 圆角 + 柔影 -->
                                        <Border Classes="TransferCard"
                                                Background="{DynamicResource Brush.Surface}"
                                                CornerRadius="{DynamicResource Radius.Lg}"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1"
                                                BoxShadow="{DynamicResource Shadow.Sm}"
                                                DoubleTapped="TransferCard_DoubleTapped">
                                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                                  ColumnSpacing="10" RowSpacing="5">

                                                <!-- [缩略图 / 文件头像] -->
                                                <Border x:Name="ThumbArea"
                                                        Classes="ThumbArea"
                                                        Grid.RowSpan="4"
                                                        CornerRadius="{DynamicResource Radius.Md}"
                                                        Background="{DynamicResource Brush.SurfaceAlt}"
                                                        ClipToBounds="True"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <Grid>
                                                        <!-- 有缩略图时显示图片 -->
                                                        <Image Source="{Binding ThumbnailImage}"
                                                               IsVisible="{Binding ThumbnailImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        <!-- 无缩略图时显示按扩展名匹配的图标 + 底色 -->
                                                        <ContentPresenter IsVisible="{Binding ThumbnailImage, Converter={x:Static ObjectConverters.IsNull}}">
                                                            <ContentPresenter.Content>
                                                                <Grid>
                                                                    <Border Background="{Binding FileName,
                                                                        Converter={x:Static conv:ExtensionToBrushConverter.Instance}}" />
                                                                    <StackPanel Spacing="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding FileName,
                                                                            Converter={x:Static conv:ExtensionToGlyphConverter.Instance}}"
                                                                                   FontSize="20"
                                                                                   Foreground="White"
                                                                                   HorizontalAlignment="Center" />
                                                                        <TextBlock Text="{Binding FileName,
                                                                            Converter={x:Static conv:ExtensionToExtLabelConverter.Instance}}"
                                                                                   FontSize="9"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="White"
                                                                                   HorizontalAlignment="Center"
                                                                                   Opacity="0.9" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </ContentPresenter.Content>
                                                        </ContentPresenter>
                                                        <!-- 双击打开暗示：仅已完成接收任务显示（右下角 ↗ 角标） -->
                                                        <Border HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom"
                                                                Margin="4"
                                                                Padding="5,1"
                                                                Background="#CC0F172A"
                                                                CornerRadius="{DynamicResource Radius.Sm}"
                                                                IsVisible="{Binding CanOpenFile}">
                                                            <TextBlock Text="↗"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="White" />
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- [文件名 + 元信息行] -->
                                                <!-- 直接用 TextBlock 而非 StackPanel：Grid 的 * 列会约束宽度，
                                                     TextTrimming 才能正确生效；否则长文件名会把右侧操作按钮挤出可视区 -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding FileName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,Auto,*">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding MetaText}"
                                                               Classes="Muted"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="160" />
                                                    <TextBlock Grid.Column="1"
                                                               Text=" · "
                                                               Foreground="{DynamicResource Brush.TextMuted}" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding StateText}"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{Binding State, Converter={StaticResource StatusToColor}}" />
                                                </Grid>

                                                <!-- [进度条] -->
                                                <ProgressBar Grid.Row="2" Grid.Column="1"
                                                             Minimum="0" Maximum="100"
                                                             Value="{Binding AnimatedProgress}"
                                                             IsVisible="{Binding !ShowWaitHint}" />

                                                <!-- [进度信息行：百分比(左) + 速度(右)]，置于进度条下方，不再压叠在条上 -->
                                                <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="Auto,*"
                                                      IsVisible="{Binding !ShowWaitHint}">
                                                    <TextBlock Grid.Column="0"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontWeight="SemiBold" FontSize="11"
                                                               Text="{Binding AnimatedProgress, StringFormat='{}{0:0.#} %'}" />
                                                    <TextBlock Grid.Column="1"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="11"
                                                               Text="{Binding SpeedText}" />
                                                </Grid>

                                                <!-- [等待审批/准备中提示行]：进度条与信息行后半段被此提示行整行替换 -->
                                                <TextBlock Grid.Row="2" Grid.RowSpan="2" Grid.Column="1"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Classes="Muted"
                                                           FontWeight="SemiBold" FontSize="11"
                                                           Text="{Binding StateText}"
                                                           IsVisible="{Binding ShowWaitHint}" />

                                                <!-- [错误提示行]：失败/断开/取消时显示错误原因（两套主题令牌）；仅占内容列，避免压到右侧按钮 -->
                                                <Border Grid.Row="4" Grid.Column="1"
                                                        Background="{DynamicResource Brush.ErrorBg}"
                                                        BorderBrush="{DynamicResource Brush.ErrorBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource Radius.Sm}"
                                                        Padding="8,5"
                                                        IsVisible="{Binding ShowErrorHint}">
                                                    <TextBlock Text="{Binding ErrorMessage}"
                                                               Foreground="{DynamicResource Brush.ErrorText}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap" />
                                                </Border>

                                                <!-- [操作按钮：暂停/恢复/取消/删除] -->
                                                <StackPanel Grid.RowSpan="5" Grid.Column="2"
                                                            Orientation="Horizontal" Spacing="2"
                                                            VerticalAlignment="Center">
                                                    <Button Classes="Icon" Content="⏸"
                                                            Command="{Binding PauseCommand}"
                                                            IsVisible="{Binding IsRunning}"
                                                            ToolTip.Tip="{svc:Localize Key=Pause}" />
                                                    <Button Classes="Icon" Content="▶"
                                                            Command="{Binding ResumeCommand}"
                                                            IsVisible="{Binding IsPaused}"
                                                            ToolTip.Tip="{svc:Localize Key=Resume}" />
                                                    <Button Classes="Icon" Content="↻"
                                                            Command="{Binding RetryCommand}"
                                                            IsVisible="{Binding CanRetry}"
                                                            ToolTip.Tip="{svc:Localize Key=Retry}" />
                                                    <Button Classes="Icon Danger" Content="✕"
                                                            Command="{Binding CancelCommand}"
                                                            IsVisible="{Binding CanCancel}"
                                                            ToolTip.Tip="{svc:Localize Key=Cancel}" />
                                                    <Button Classes="Icon" Content="🗑"
                                                            Command="{Binding DeleteCommand}"
                                                            IsVisible="{Binding CanDelete}"
                                                            ToolTip.Tip="{svc:Localize Key=DeleteTask}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- +++++ 底栏：状态（左）+ 齿轮入口（右），单行永不溢出 +++++ -->
        <Border Grid.Row="2"
                Classes="BottomBar"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- 在线设备小圆点 -->
                    <Ellipse Width="8" Height="8"
                             Fill="{DynamicResource Brush.Success}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{svc:Localize Key=OnlineLabel, Args={Binding Devices.Devices.Count}}"
                               Classes="Subtitle" />
                    <TextBlock Text="·" Foreground="{DynamicResource Brush.TextMuted}"
                               IsVisible="{Binding !IsCompact}" />
                    <TextBlock Text="{svc:Localize Key=TasksLabel, Args={Binding Transfers.Count}}"
                               Classes="Subtitle"
                               IsVisible="{Binding !IsCompact}" />
                    <TextBlock Text="|"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               IsVisible="{Binding !IsCompact}" />
                    <TextBlock Text="{svc:Localize Key=DragDropFlow}"
                               Classes="Muted"
                               IsVisible="{Binding !IsCompact}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="Icon" Content="⚙️"
                            ToolTip.Tip="{svc:Localize Key=Settings}"
                            Click="OnOpenSettingsClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- +++++ 覆盖面板：日志查看 / 关于（置于布局最上层，配返回按钮） +++++ -->
        <Border x:Name="OverlayPane"
                Grid.RowSpan="3"
                Background="{DynamicResource Brush.Surface}"
                IsVisible="False">
            <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="14,12">
                    <Button Classes="Icon" Content="←"
                            ToolTip.Tip="{svc:Localize Key=Back}"
                            Click="OnCloseOverlayClick" />
                    <TextBlock x:Name="OverlayTitle"
                               Grid.Column="1"
                               Classes="Title"
                               FontSize="17"
                               VerticalAlignment="Center" />
                </Grid>
                <ContentControl x:Name="OverlayContent"
                                Grid.Row="1"
                                Margin="14,0,14,14" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
