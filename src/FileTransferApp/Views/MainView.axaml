<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FileTransferApp.ViewModels"
             xmlns:models="using:FileTransferApp.Core.Models"
             xmlns:conv="using:FileTransferApp.Converters"
             xmlns:svc="using:FileTransferApp.Services"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="760"
             x:Class="FileTransferApp.Views.MainView"
             x:DataType="vm:MainViewModel"
             TopLevel.AutoSafeAreaPadding="False"
             DragDrop.AllowDrop="True">

    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor" />
    </UserControl.Resources>

    <!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++
         响应式样式：基于 RootGrid 上的 Classes.compact / Classes.short 级联
         - compact (竖屏手机, 宽<600)：单列布局，压缩 padding、缩小缩略图、隐藏次要文案
         - short   (横屏手机, 宽≥600 但高<500)：两栏布局，压缩顶栏/底栏纵向 padding
         两者互斥(IsCompact 优先)，通过 Grid.compact > / Grid.short > 直接子选择器命中
         +++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <UserControl.Styles>
        <!-- 基础样式(标准模式=桌面/平板)：把要响应式覆盖的 inline 值提到 Style，
             否则 Avalonia 中 inline 值优先级高于 Style setter，覆盖不生效 -->
        <Style Selector="Border.TopBar">
            <Setter Property="Padding" Value="16,14,16,18" />
        </Style>
        <Style Selector="Border.BottomBar">
            <Setter Property="Padding" Value="16,10" />
        </Style>
        <Style Selector="Border.TransferCard">
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style Selector="Border.ThumbArea">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
        </Style>

        <!-- 竖屏手机(compact, 宽<600)：单列布局，压缩 padding、缩小缩略图 -->
        <Style Selector="Grid.compact > Border.TopBar">
            <!-- 顶栏纵向内边距收紧：紫色区高度 = 状态栏(safe.Top) + 内容(≈44)，避免顶栏"过宽/过高"。
                 安全区仍由 MainView.axaml.cs 以 Margin 垫给内容列，保证紫色铺到屏幕最顶。 -->
            <Setter Property="Padding" Value="12,6,12,6" />
            <!-- 最小高度仅作无刘海/无状态栏时的兜底；有安全区时实际高度由 safe.Top+内容决定，
                 故此处取 48 与"状态栏+内容"观感一致，不再把顶栏撑高。 -->
            <Setter Property="MinHeight" Value="48" />
        </Style>
        <Style Selector="Grid.compact > Border.BottomBar">
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="Grid.compact Border.TransferCard">
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="Grid.compact Border.ThumbArea">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
        </Style>

        <!-- 横屏手机(short, 宽≥600 但高<500)：两栏布局，压缩顶栏/底栏纵向 padding -->
        <Style Selector="Grid.short > Border.TopBar">
            <Setter Property="Padding" Value="12,6,12,8" />
            <Setter Property="CornerRadius" Value="0,0,16,16" />
            <Setter Property="BoxShadow" Value="0 4 12 0 rgba(99,102,241,0.18)" />
        </Style>
        <Style Selector="Grid.short > Border.BottomBar">
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style Selector="Grid.short Border.TransferCard">
            <Setter Property="Padding" Value="14,8" />
        </Style>

        <!-- 空态压缩（compact/short 共用）：设备面板在高/宽受限时容器可能比
             图标+文案更矮，若保持 FontSize24+Spacing10 会把内容顶出圆角框。
             这里同时收小图标、收紧间距、缩小文案换行上限，确保空态始终
             居中且完整待在圆角 Card 内部。 -->
        <Style Selector="Grid.compact StackPanel.DeviceEmpty, Grid.short StackPanel.DeviceEmpty">
            <Setter Property="Spacing" Value="6" />
            <Setter Property="Margin" Value="6,12" />
        </Style>
        <Style Selector="Grid.compact StackPanel.DeviceEmpty TextBlock.Icon, Grid.short StackPanel.DeviceEmpty TextBlock.Icon">
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style Selector="Grid.compact StackPanel.DeviceEmpty TextBlock.Hint, Grid.short StackPanel.DeviceEmpty TextBlock.Hint">
            <Setter Property="MaxWidth" Value="180" />
        </Style>
    </UserControl.Styles>


    <!-- 根背景：现代 App 惯用的「浅灰底」，承载白色卡片形成层次感 -->
    <!-- 安全区：AutoSafeAreaPadding 由 TopLevel 从**其内容(MainView)**读取并作用于内容 Padding，
         所以标在 UserControl 根上（= MainView，即 TopLevel.Content）才有效，标在本 Grid 上无效。
         关闭后安全区由 MainView.axaml.cs 监听 InsetsManager.SafeAreaChanged 手动垫到
         TopBar/BottomBar 的内容层，让紫色 / 卡片背景真正铺满到屏幕边缘，且不再双重叠加。 -->
    <Grid RowDefinitions="Auto,*,Auto"
          x:Name="RootGrid"
          Background="{DynamicResource Brush.SurfaceAlt}"
          Classes.compact="{Binding IsCompact}"
          Classes.short="{Binding IsShort}">

        <!-- +++++ 顶栏：品牌感 + 主操作（紧凑单行：Android 竖向全屏下高度≈48dp） +++++ -->
        <Border Classes="TopBar"
                Background="{DynamicResource Brush.BrandGradient}"
                CornerRadius="0,0,14,14"
                BoxShadow="0 3 10 0 #29FFFFFF">
            <Grid x:Name="TopBarContentColumn"
                  ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" RowDefinitions="Auto">
                <!-- 品牌 Logo + 标题 -->
                <Border Grid.RowSpan="1"
                        Background="#33FFFFFF"
                        CornerRadius="9"
                        Padding="6,4"
                        Width="32" Height="32"
                        VerticalAlignment="Center">
                    <TextBlock Text="🚀"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{svc:Localize Key=AppTitle}"
                               Classes="Title"
                               FontSize="16"
                               Foreground="{DynamicResource Brush.TextOnBrand}" />
                </StackPanel>
                <!-- 主操作：选择文件（标准模式：完整文字按钮） -->
                <Button Grid.Column="2" Grid.RowSpan="2"
                        Classes="Primary"
                        Content="{svc:Localize Key=SelectFileSend}"
                        Command="{Binding SendFileCommand}"
                        IsEnabled="{Binding Devices.SelectedDevice, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Padding="20,10"
                        IsVisible="{Binding !IsCompact}" />
                <!-- 主操作：选择文件（竖屏紧凑模式：图标按钮省横向空间） -->
                <Button Grid.Column="2" Grid.RowSpan="2"
                        Classes="Primary"
                        Content="📁"
                        FontSize="18"
                        Command="{Binding SendFileCommand}"
                        IsEnabled="{Binding Devices.SelectedDevice, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Padding="0"
                        Width="44" Height="44"
                        IsVisible="{Binding IsCompact}" />
            </Grid>
        </Border>

        <!-- +++++ 主体：设备发现 + 传输任务（卡片式） +++++ -->
        <!-- LayoutRoot 的列/行定义 + DevicesPanel/TransfersPanel 的 Grid.Row/Grid.Column，
             由 MainView.axaml.cs 中 UpdateLayoutForCompact() 按 IsCompact 动态设置：
             - 宽屏：设备=左(320) / 传输=右(*)
             - 窄屏：设备=上(Auto, 限高260) / 传输=下(*) -->
        <Grid Grid.Row="1" Margin="12,12,12,8">
            <Grid x:Name="LayoutRoot">

                <!-- [左上] 附近设备卡片 -->
                <Border x:Name="DevicesPanel"
                        Classes="DevicesPanel Card"
                        Grid.Row="0" Grid.Column="0"
                        Margin="0,0,12,0">
                    <DockPanel LastChildFill="True">
                        <!-- 卡片标题 + 在线数徽标 -->
                        <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{svc:Localize Key=NearbyDevices}"
                                       Classes="Title"
                                       FontSize="16" />
                            <Button DockPanel.Dock="Right"
                                    Classes="Icon"
                                    Content="🔗"
                                    ToolTip.Tip="{svc:Localize Key=Connect.Title}"
                                    Click="OnOpenConnectClick"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Right"
                                    Background="{DynamicResource Brush.Brand}"
                                    CornerRadius="{DynamicResource Radius.Pill}"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{svc:Localize Key=OnlineCount, Args={Binding Devices.Devices.Count}}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextOnBrand}" />
                            </Border>
                        </DockPanel>

                        <!-- 主操作按钮（紧凑模式也能用） -->
                        <Button DockPanel.Dock="Bottom"
                                Classes="Primary"
                                Content="{svc:Localize Key=SelectFileAndSend}"
                                Command="{Binding SendFileCommand}"
                                IsEnabled="{Binding Devices.SelectedDevice, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Margin="0,10,0,0" />

                        <!-- 直连输入区 -->
                        <Border DockPanel.Dock="Bottom"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                CornerRadius="{DynamicResource Radius.Md}"
                                Padding="10,8"
                                Margin="0,10,0,0">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                                  ColumnSpacing="8" RowSpacing="6">
                                <TextBox Grid.Column="0"
                                         Text="{Binding Devices.ManualIp}"
                                         PlaceholderText="{svc:Localize Key=ManualIpPlaceholder}" />
                                <Button Grid.Column="1"
                                        Content="{svc:Localize Key=Connect}"
                                        Command="{Binding ManualConnectCommand}" />
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                           Classes="Muted"
                                           Text="{svc:Localize Key=PortHint, Args={Binding Devices.ManualPort}}"
                                           IsVisible="{Binding !IsCompact}" />
                            </Grid>
                        </Border>

                        <!-- 设备列表 -->
                        <Border CornerRadius="{DynamicResource Radius.Lg}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                Margin="0,10,0,0"
                                ClipToBounds="True">
                            <Grid>
                                <!-- 空态：简洁提示（微信风格，本机信息移至"关于"页） -->
                                <!-- 理论上空态占满整个设备区垂直居中；ClipToBounds 在容器过矮时
                                     防止内容画出圆角边框。紧凑模式会进一步缩小图标/间距(见样式)。 -->
                                <!-- 空态改为横向：图标在左、提示词在右。
                                     设备区在紧凑模式下可用高度有限，纵向堆叠会把提示词换行后裁切；
                                     横向布局让文字贴着图标右侧换行，完整显示"等待附近设备连接"。 -->
                                <StackPanel Classes="DeviceEmpty"
                                            IsVisible="{Binding Devices.IsEmpty}"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="8"
                                            Margin="12,16">
                                    <TextBlock Classes="Icon"
                                               Text="🔍"
                                               FontSize="20"
                                               VerticalAlignment="Center" />
                                    <TextBlock Classes="Hint Muted"
                                               Text="{svc:Localize Key=DeviceEmptyWaiting}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="220" />
                                </StackPanel>
                                <ListBox ItemsSource="{Binding Devices.Devices}"
                                         SelectedItem="{Binding Devices.SelectedDevice}"
                                         Background="#00000000"
                                         Padding="4">
<ListBox.ItemTemplate>
            <DataTemplate DataType="vm:DeviceNodeViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="2" VerticalAlignment="Center">
                                            <!-- 设备头像（Windows/Android 标识色） -->
                                            <Border Width="40" Height="40" CornerRadius="{DynamicResource Radius.Md}"
                                                    Background="{Binding DeviceType,
                                                        Converter={x:Static conv:DeviceTypeToBrushConverter.Instance}}"
                                                    Margin="0,0,10,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontSize="18"
                                                           Text="{Binding DeviceType,
                                                               Converter={x:Static conv:DeviceTypeToGlyphConverter.Instance}}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" FontSize="14"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding EndPoint}" Classes="Muted" />
                                            </StackPanel>
                                            <!-- 配对状态徽标：🔓=未配对（首次发送自动配对） / 🔒=已配对加密传输（点按解除配对） -->
                                            <Button Grid.Column="2"
                                                    Classes="Icon"
                                                    Content="🔒"
                                                    IsVisible="{Binding IsPaired}"
                                                    ToolTip.Tip="{svc:Localize Key=Pair.Unpair}"
                                                    Command="{Binding $parent[ListBox].DataContext.Devices.UnpairCommand}"
                                                    CommandParameter="{Binding}"
                                                    VerticalAlignment="Center"
                                                    Margin="2,0,0,0" />
                                            <TextBlock Grid.Column="2"
                                                       Text="🔓"
                                                       IsVisible="{Binding !IsPaired}"
                                                       ToolTip.Tip="{svc:Localize Key=Pair.Unpaired}"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0,0,0" />
                                            <!-- 选中指示：箭头 -->
                                            <TextBlock Grid.Column="3" Text="›" FontSize="22"
                                                       Foreground="{DynamicResource Brush.TextMuted}"
                                                       VerticalAlignment="Center" Margin="4,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </Grid>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- [右下] 传输任务列表卡片 -->
                <Border x:Name="TransfersPanel"
                        Grid.Row="1" Grid.Column="1"
                        Classes="Card">
                    <DockPanel LastChildFill="True">
                        <!-- 标题 + 提示 -->
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{svc:Localize Key=TransferTasks}"
                                       Classes="Title"
                                       FontSize="16"
                                       VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{svc:Localize Key=DragDropHint}"
                                           Classes="Muted"
                                           IsVisible="{Binding !IsCompact}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OverallProgress, StringFormat='{}{0:0} %'}"
                                           Classes="Muted"
                                           IsVisible="{Binding HasActive}"
                                           VerticalAlignment="Center" />
                                <Button Classes="Icon" Content="⏸"
                                        ToolTip.Tip="{svc:Localize Key=PauseAll}"
                                        Command="{Binding PauseAllCommand}"
                                        IsVisible="{Binding HasActive}" />
                                <Button Classes="Icon" Content="▶"
                                        ToolTip.Tip="{svc:Localize Key=ResumeAll}"
                                        Command="{Binding ResumeAllCommand}"
                                        IsVisible="{Binding HasPaused}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- +++++ 传输列表内容区：空态提示 + 列表 +++++ -->
                        <Grid>
                            <StackPanel IsVisible="{Binding !HasTransfers}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="6"
                                        Margin="12,20">
                                <TextBlock Text="📄"
                                           FontSize="28"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{svc:Localize Key=TransferEmptyHint}"
                                           Classes="Body"
                                           TextAlignment="Center" />
                            </StackPanel>
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Transfers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:TransferItemViewModel">
                                        <!-- 现代任务卡片：白底 + 圆角 + 柔影 -->
                                        <Border Classes="TransferCard"
                                                Background="{DynamicResource Brush.Surface}"
                                                CornerRadius="{DynamicResource Radius.Lg}"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1"
                                                BoxShadow="{DynamicResource Shadow.Sm}"
                                                DoubleTapped="TransferCard_DoubleTapped">
                                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                                  ColumnSpacing="10" RowSpacing="5">

                                                <!-- [缩略图 / 文件头像]：只跨"标题 + 元信息"两行，
                                                     不再跨越进度行 —— 从结构上杜绝进度条压住缩略图 -->
                                                <Border x:Name="ThumbArea"
                                                        Classes="ThumbArea"
                                                        Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                                        CornerRadius="{DynamicResource Radius.Md}"
                                                        Background="{DynamicResource Brush.SurfaceAlt}"
                                                        ClipToBounds="True"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <Grid>
                                                        <!-- 有缩略图时显示图片 -->
                                                        <Image Source="{Binding ThumbnailImage}"
                                                               IsVisible="{Binding ThumbnailImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        <!-- 无缩略图时显示按扩展名匹配的图标 + 底色 -->
                                                        <ContentPresenter IsVisible="{Binding ThumbnailImage, Converter={x:Static ObjectConverters.IsNull}}">
                                                            <ContentPresenter.Content>
                                                                <Grid>
                                                                    <Border Background="{Binding FileName,
                                                                        Converter={x:Static conv:ExtensionToBrushConverter.Instance}}" />
                                                                    <StackPanel Spacing="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding FileName,
                                                                            Converter={x:Static conv:ExtensionToGlyphConverter.Instance}}"
                                                                                   FontSize="20"
                                                                                   Foreground="White"
                                                                                   HorizontalAlignment="Center" />
                                                                        <TextBlock Text="{Binding FileName,
                                                                            Converter={x:Static conv:ExtensionToExtLabelConverter.Instance}}"
                                                                                   FontSize="9"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="White"
                                                                                   HorizontalAlignment="Center"
                                                                                   Opacity="0.9" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </ContentPresenter.Content>
                                                        </ContentPresenter>
                                                        <!-- 双击打开暗示：仅已完成接收任务显示（右下角 ↗ 角标） -->
                                                        <Border HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom"
                                                                Margin="4"
                                                                Padding="5,1"
                                                                Background="#CC0F172A"
                                                                CornerRadius="{DynamicResource Radius.Sm}"
                                                                IsVisible="{Binding CanOpenFile}">
                                                            <TextBlock Text="↗"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="White" />
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- [文件名 + 元信息行] -->
                                                <!-- 直接用 TextBlock 而非 StackPanel：Grid 的 * 列会约束宽度，
                                                     TextTrimming 才能正确生效；否则长文件名会把右侧操作按钮挤出可视区 -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding FileName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,Auto,*">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding MetaText}"
                                                               Classes="Muted"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="160" />
                                                    <TextBlock Grid.Column="1"
                                                               Text=" · "
                                                               Foreground="{DynamicResource Brush.TextMuted}" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding StateText}"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{Binding State, Converter={StaticResource StatusToColor}}" />
                                                </Grid>

                                                <!-- [进度条]：整行跨越三列，位于缩略图下方，结构上不可能与缩略图重叠 -->
                                                <ProgressBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                                             Height="8" VerticalAlignment="Center"
                                                             Minimum="0" Maximum="100"
                                                             Value="{Binding AnimatedProgress}"
                                                             IsVisible="{Binding !ShowWaitHint}" />

                                                <!-- [进度信息行：百分比(左) + 速度(右)]：整行 -->
                                                <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="Auto,*"
                                                      IsVisible="{Binding !ShowWaitHint}">
                                                    <TextBlock Grid.Column="0"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontWeight="SemiBold" FontSize="11"
                                                               Text="{Binding AnimatedProgress, StringFormat='{}{0:0.#} %'}" />
                                                    <TextBlock Grid.Column="1"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="11"
                                                               Text="{Binding SpeedText}" />
                                                </Grid>

                                                <!-- [等待审批/准备中提示行]：进度条与信息行后半段被此提示行整行替换 -->
                                                <TextBlock Grid.Row="2" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Classes="Muted"
                                                           FontWeight="SemiBold" FontSize="11"
                                                           Text="{Binding StateText}"
                                                           IsVisible="{Binding ShowWaitHint}" />

                                                <!-- [错误提示行]：失败/断开/取消时显示错误原因（两套主题令牌）；仅占内容列，避免压到右侧按钮 -->
                                                <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                                         Background="{DynamicResource Brush.ErrorBg}"
                                                        BorderBrush="{DynamicResource Brush.ErrorBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource Radius.Sm}"
                                                        Padding="8,5"
                                                        IsVisible="{Binding ShowErrorHint}">
                                                    <TextBlock Text="{Binding ErrorMessage}"
                                                               Foreground="{DynamicResource Brush.ErrorText}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap" />
                                                </Border>

                                                <!-- [操作按钮：暂停/恢复/取消/删除] -->
                                                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                                             Orientation="Horizontal" Spacing="2"
                                                             VerticalAlignment="Center">
                                                    <Button Classes="Icon" Content="⏸"
                                                            Command="{Binding PauseCommand}"
                                                            IsVisible="{Binding IsRunning}"
                                                            ToolTip.Tip="{svc:Localize Key=Pause}" />
                                                    <Button Classes="Icon" Content="▶"
                                                            Command="{Binding ResumeCommand}"
                                                            IsVisible="{Binding IsPaused}"
                                                            ToolTip.Tip="{svc:Localize Key=Resume}" />
                                                    <Button Classes="Icon" Content="↻"
                                                            Command="{Binding RetryCommand}"
                                                            IsVisible="{Binding CanRetry}"
                                                            ToolTip.Tip="{svc:Localize Key=Retry}" />
                                                    <Button Classes="Icon Danger" Content="✕"
                                                            Command="{Binding CancelCommand}"
                                                            IsVisible="{Binding CanCancel}"
                                                            ToolTip.Tip="{svc:Localize Key=Cancel}" />
                                                    <Button Classes="Icon" Content="🗑"
                                                            Command="{Binding DeleteCommand}"
                                                            IsVisible="{Binding CanDelete}"
                                                            ToolTip.Tip="{svc:Localize Key=DeleteTask}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- +++++ 底栏：状态（左）+ 齿轮入口（右），单行永不溢出 +++++ -->
        <Border Grid.Row="2"
                Classes="BottomBar"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0">
            <Grid x:Name="BottomBarContentColumn" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- 在线设备小圆点 -->
                    <Ellipse Width="8" Height="8"
                             Fill="{DynamicResource Brush.Success}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{svc:Localize Key=OnlineLabel, Args={Binding Devices.Devices.Count}}"
                               Classes="Subtitle" />
                    <TextBlock Text="·" Foreground="{DynamicResource Brush.TextMuted}"
                               IsVisible="{Binding !IsCompact}" />
                    <TextBlock Text="{svc:Localize Key=TasksLabel, Args={Binding Transfers.Count}}"
                               Classes="Subtitle"
                               IsVisible="{Binding !IsCompact}" />
                    <TextBlock Text="|"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               IsVisible="{Binding !IsCompact}" />
                    <TextBlock Text="{svc:Localize Key=DragDropFlow}"
                               Classes="Muted"
                               IsVisible="{Binding !IsCompact}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="Icon" Content="⚙️"
                            ToolTip.Tip="{svc:Localize Key=Settings}"
                            Click="OnOpenSettingsClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- +++++ 覆盖面板：日志查看 / 关于（置于布局最上层，配返回按钮） +++++ -->
        <Border x:Name="OverlayPane"
                Grid.RowSpan="3"
                Background="{DynamicResource Brush.Surface}"
                IsVisible="False">
            <Grid RowDefinitions="Auto,*">
                <Grid x:Name="OverlayHeaderGrid"
                      ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="14,12">
                    <Button Classes="Icon" Content="←"
                            ToolTip.Tip="{svc:Localize Key=Back}"
                            Click="OnCloseOverlayClick" />
                    <TextBlock x:Name="OverlayTitle"
                               Grid.Column="1"
                               Classes="Title"
                               FontSize="17"
                               VerticalAlignment="Center" />
                </Grid>
                <ContentControl x:Name="OverlayContent"
                                Grid.Row="1"
                                Margin="14,0,14,14" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
