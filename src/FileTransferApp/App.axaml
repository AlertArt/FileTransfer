<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:FileTransferApp"
             x:Class="FileTransferApp.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++
         Design Tokens: 颜色 / 画笔 / 圆角 / 间距 / 阴影 (统一规范)
         注意：所有令牌均放在 Application.Resources 中，可被
               DynamicResource 与 Style.Setter 一致引用。
         +++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <Application.Resources>
        <ResourceDictionary>
            <!-- [主题相关令牌]：表面 / 文字 / 边框 分 Light + Dark 两套，
                 跟随系统 RequestedThemeVariant(Default) 自动切换 -->
            <ResourceDictionary.ThemeDictionaries>
                <!-- Light -->
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="Color.Surface">#FFFFFF</Color>
                    <Color x:Key="Color.SurfaceAlt">#F8FAFC</Color>
                    <Color x:Key="Color.SurfaceMuted">#F1F5F9</Color>
                    <Color x:Key="Color.Border">#E2E8F0</Color>
                    <Color x:Key="Color.BorderStrong">#CBD5E1</Color>
                    <Color x:Key="Color.TextPrimary">#0F172A</Color>
                    <Color x:Key="Color.TextSecondary">#475569</Color>
                    <Color x:Key="Color.TextMuted">#94A3B8</Color>
                    <Color x:Key="Color.TextOnBrand">#FFFFFF</Color>
                    <!-- 语义 soft 色：浅色下用柔和的浅底 + 深色前景 -->
                    <Color x:Key="Color.ErrorBg">#FFFBF0</Color>
                    <Color x:Key="Color.ErrorBorder">#FFB4A0</Color>
                    <Color x:Key="Color.ErrorText">#B42318</Color>
                    <Color x:Key="Color.DangerSoftBg">#FEF2F2</Color>
                    <Color x:Key="Color.DangerSoftBorder">#FECACA</Color>
                    <Color x:Key="Color.SelectionBg">#EEF2FF</Color>
                    <Color x:Key="Color.SelectionFg">#4F46E5</Color>

                    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
                    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
                    <SolidColorBrush x:Key="Brush.SurfaceMuted" Color="{StaticResource Color.SurfaceMuted}" />
                    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
                    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
                    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
                    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
                    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
                    <SolidColorBrush x:Key="Brush.TextOnBrand" Color="{StaticResource Color.TextOnBrand}" />
                    <SolidColorBrush x:Key="Brush.ErrorBg" Color="{StaticResource Color.ErrorBg}" />
                    <SolidColorBrush x:Key="Brush.ErrorBorder" Color="{StaticResource Color.ErrorBorder}" />
                    <SolidColorBrush x:Key="Brush.ErrorText" Color="{StaticResource Color.ErrorText}" />
                    <SolidColorBrush x:Key="Brush.DangerSoftBg" Color="{StaticResource Color.DangerSoftBg}" />
                    <SolidColorBrush x:Key="Brush.DangerSoftBorder" Color="{StaticResource Color.DangerSoftBorder}" />
                    <SolidColorBrush x:Key="Brush.SelectionBg" Color="{StaticResource Color.SelectionBg}" />
                    <SolidColorBrush x:Key="Brush.SelectionFg" Color="{StaticResource Color.SelectionFg}" />
                </ResourceDictionary>
                <!-- Dark：slate 基底，与 Light 保持同构键集 -->
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="Color.Surface">#0F172A</Color>
                    <Color x:Key="Color.SurfaceAlt">#172033</Color>
                    <Color x:Key="Color.SurfaceMuted">#1E293B</Color>
                    <Color x:Key="Color.Border">#263449</Color>
                    <Color x:Key="Color.BorderStrong">#334155</Color>
                    <Color x:Key="Color.TextPrimary">#E2E8F0</Color>
                    <Color x:Key="Color.TextSecondary">#94A3B8</Color>
                    <Color x:Key="Color.TextMuted">#64748B</Color>
                    <Color x:Key="Color.TextOnBrand">#FFFFFF</Color>
                    <!-- 语义 soft 色：深色下用深琥珀红底色 + 亮琥珀前景保证对比 -->
                    <Color x:Key="Color.ErrorBg">#3D2A12</Color>
                    <Color x:Key="Color.ErrorBorder">#92400E</Color>
                    <Color x:Key="Color.ErrorText">#FDE68A</Color>
                    <Color x:Key="Color.DangerSoftBg">#450A0A</Color>
                    <Color x:Key="Color.DangerSoftBorder">#7F1D1D</Color>
                    <Color x:Key="Color.SelectionBg">#312E81</Color>
                    <Color x:Key="Color.SelectionFg">#C7D2FE</Color>

                    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
                    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
                    <SolidColorBrush x:Key="Brush.SurfaceMuted" Color="{StaticResource Color.SurfaceMuted}" />
                    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
                    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
                    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
                    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
                    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
                    <SolidColorBrush x:Key="Brush.TextOnBrand" Color="{StaticResource Color.TextOnBrand}" />
                    <SolidColorBrush x:Key="Brush.ErrorBg" Color="{StaticResource Color.ErrorBg}" />
                    <SolidColorBrush x:Key="Brush.ErrorBorder" Color="{StaticResource Color.ErrorBorder}" />
                    <SolidColorBrush x:Key="Brush.ErrorText" Color="{StaticResource Color.ErrorText}" />
                    <SolidColorBrush x:Key="Brush.DangerSoftBg" Color="{StaticResource Color.DangerSoftBg}" />
                    <SolidColorBrush x:Key="Brush.DangerSoftBorder" Color="{StaticResource Color.DangerSoftBorder}" />
                    <SolidColorBrush x:Key="Brush.SelectionBg" Color="{StaticResource Color.SelectionBg}" />
                    <SolidColorBrush x:Key="Brush.SelectionFg" Color="{StaticResource Color.SelectionFg}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- [Colors]：品牌 / 语义色，两套主题共用（品牌渐变恒定） -->
            <Color x:Key="Color.Brand">#6366F1</Color>
            <Color x:Key="Color.BrandDark">#4F46E5</Color>
            <Color x:Key="Color.BrandLight">#A5B4FC</Color>
            <Color x:Key="Color.Accent">#22D3EE</Color>
            <Color x:Key="Color.Success">#10B981</Color>
            <Color x:Key="Color.Warning">#F59E0B</Color>
            <Color x:Key="Color.Danger">#EF4444</Color>
            <Color x:Key="Color.Info">#3B82F6</Color>

            <!-- [Brushes]：品牌 / 语义色 -->
            <SolidColorBrush x:Key="Brush.Brand" Color="{StaticResource Color.Brand}" />
            <SolidColorBrush x:Key="Brush.BrandDark" Color="{StaticResource Color.BrandDark}" />
            <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
            <LinearGradientBrush x:Key="Brush.BrandGradient" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="{StaticResource Color.Brand}" Offset="0" />
                <GradientStop Color="#8B5CF6" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Brush.ProgressGradient" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="{StaticResource Color.Brand}" Offset="0" />
                <GradientStop Color="{StaticResource Color.Accent}" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
            <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
            <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
            <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />

            <!-- [CornerRadius] -->
            <CornerRadius x:Key="Radius.Sm">4</CornerRadius>
            <CornerRadius x:Key="Radius.Md">8</CornerRadius>
            <CornerRadius x:Key="Radius.Lg">12</CornerRadius>
            <CornerRadius x:Key="Radius.Xl">16</CornerRadius>
            <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

            <!-- [Spacing / Thickness] -->
            <Thickness x:Key="Spacing.Xs">4</Thickness>
            <Thickness x:Key="Spacing.Sm">8</Thickness>
            <Thickness x:Key="Spacing.Md">12</Thickness>
            <Thickness x:Key="Spacing.Lg">16</Thickness>
            <Thickness x:Key="Spacing.Xl">20</Thickness>

            <!-- [BoxShadow]：仅 Border 可用 (BoxShadows 是 Avalonia 12 Border 的直接属性) -->
            <BoxShadows x:Key="Shadow.Sm">0 1 2 0 rgba(15,23,42,0.06)</BoxShadows>
            <BoxShadows x:Key="Shadow.Md">0 4 8 0 rgba(15,23,42,0.08), 0 2 4 0 rgba(15,23,42,0.04)</BoxShadows>
            <BoxShadows x:Key="Shadow.Lg">0 12 24 0 rgba(15,23,42,0.10), 0 4 8 0 rgba(15,23,42,0.05)</BoxShadows>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++
             全局控件默认样式：覆盖 FluentTheme 呆板默认，现代 App 观感
             注意：Button / TextBox / ListBox 本身没有 BoxShadow 属性，
                   阴影通过外层 Border 承载；这里只对 Border.Card 设置。
             +++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
        </Style>

        <Style Selector="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- 主色按钮 (Classes=Primary) -->
        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="{DynamicResource Brush.BrandGradient}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnBrand}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.Primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.BrandDark}" />
        </Style>
        <Style Selector="Button.Primary:disabled">
            <Setter Property="Background" Value="{DynamicResource Brush.BorderStrong}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        </Style>

        <!-- 危险操作按钮 (Classes=Danger) -->
        <Style Selector="Button.Danger">
            <Setter Property="Background" Value="{DynamicResource Brush.DangerSoftBg}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerSoftBorder}" />
        </Style>

        <!-- 幽灵/仅图标按钮 (Classes=Icon)：紧凑、无描边 -->
        <Style Selector="Button.Icon">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.Icon:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
        </Style>

        <!-- TextBox 现代风 -->
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Brand}" />
        </Style>

        <!-- ProgressBar 渐变进度条：加高到 16px，为叠加百分比/速度信息留出空间 -->
        <Style Selector="ProgressBar">
            <Setter Property="MinHeight" Value="16" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.ProgressGradient}" />
        </Style>

        <!-- ListBox 现代风 -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Lg}" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource Brush.SelectionBg}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.SelectionFg}" />
        </Style>

        <!-- 卡片 Border (Classes=Card)：阴影只在 Border 上生效 -->
        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Lg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="{DynamicResource Spacing.Lg}" />
            <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Md}" />
        </Style>

        <!-- 标题/副标题/小字 -->
        <Style Selector="TextBlock.Title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.Subtitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.Muted">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        </Style>
        <Style Selector="TextBlock.Body">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>
    </Application.Styles>
</Application>
